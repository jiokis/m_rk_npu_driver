# ── 逆向工程项目的忽略规则 ──

# 编译产物
*.o
*.a
*.so
*.so.*
*.elf
*.bin
build/
out/

# ── 注意：data/dumps/regcmd_*.bin 是**核心资产**，必须入库，不要忽略 ──
# 它们只有几百字节/个，是逆向的全部依据
# 只忽略真正的大体积派生文件
data/dumps/*.raw
data/traces/*.log.gz

# 从板子拷回来的大文件
*.rknn
*.rkllm
*.gguf

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store

# 临时
*.tmp
*.bak
/tmp/
